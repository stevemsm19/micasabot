FROM python:3.12-slim

WORKDIR /src

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/src

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir plotly pydantic-settings scikit-learn streamlit 

COPY src/app/frontend /src/app/frontend

EXPOSE 8501

CMD ["streamlit", "run", "app/frontend/MiCasa_Bot.py"]
